{
  "name": "banco-sangre",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de administración de banco de sangre (Proyecto integrador ABD, UDG/CUCEI)",
  "workspaces": ["apps/*", "db"],
  "engines": { "node": ">=20 <21" },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w db",
    "db:reset": "npm run reset -w db",
    "db:sintetico": "npm run sintetico -w db --",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm test -w apps/api",
    "lint": "npm run lint --workspaces --if-present"
  }
}
