# Copia a .env y cambia las contraseñas. Nunca versionar .env.

# Superusuario del contenedor (solo bootstrap: roles y bases)
POSTGRES_PASSWORD=cambia_superusuario

DB_HOST=localhost
DB_PORT=5432
DB_NAME=banco
DB_TEST_NAME=banco_test

# Dueño del esquema `banco`; corre las migraciones (NO es superusuario)
DB_OWNER_USER=banco_owner
DB_OWNER_PASSWORD=cambia_owner

# Cuenta de conexión de la API: sin privilegios propios, solo puede SET ROLE
DB_APP_USER=app_login
DB_APP_PASSWORD=cambia_app

# API
API_PORT=3000
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
